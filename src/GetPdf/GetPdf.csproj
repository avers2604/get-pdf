<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>GetPdf</AssemblyName>
    <RootNamespace>GetPdf</RootNamespace>
    <Version>0.1.3</Version>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <!-- Exe/window icon: brandbook inverse GET mark on corporate navy, legible on light and dark taskbars. -->
    <ApplicationIcon>Assets\get-pdf.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <!-- Official GET mark from GET Design System 4.1 (brandbook p.11, QA-verified). -->
    <Resource Include="Assets\get-mark.png" />
    <!-- Icon Windows shows for .pdf files handled by GET PDF (registered by the MSI ProgID). -->
    <None Include="Assets\pdf-document.ico" Link="pdf-document.ico"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="System.IO" />
    <PackageReference Include="NAPS2.Sdk" Version="1.4.0" />
    <PackageReference Include="NAPS2.Images.Wpf" Version="1.4.0" />
    <PackageReference Include="NAPS2.Tesseract.Binaries" Version="1.4.0" />
    <PackageReference Include="NAPS2.Pdfium.Binaries" Version="1.3.0" />
    <PackageReference Include="PDFsharp-WPF" Version="6.2.4" />
    <PackageReference Include="PdfPig" Version="0.1.16" />
    <PackageReference Include="Aspose.PDF.FOSS" Version="26.10.0" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Serilog" Version="4.4.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>
</Project>