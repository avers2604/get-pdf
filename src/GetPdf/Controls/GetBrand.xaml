<UserControl x:Class="GetPdf.Controls.GetBrand"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 AutomationProperties.Name="ГЭТ PDF — просмотр документов">
 <!-- DS 4.1 D41-01/02: the official brandbook mark without its wordmark; product name is separate text. -->
 <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
  <Image Source="{StaticResource GetMark}" Height="32" Margin="0,0,12,0" VerticalAlignment="Center"
         RenderOptions.BitmapScalingMode="HighQuality" SnapsToDevicePixels="True"/>
  <StackPanel VerticalAlignment="Center">
   <TextBlock FontSize="18" Foreground="{StaticResource Navy}" TextTrimming="None">
    <Run Text="ГЭТ" FontWeight="Bold"/><Run Text=" PDF" FontWeight="SemiBold"/>
   </TextBlock>
   <TextBlock Text="Просмотр документов" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,-2,0,0"/>
  </StackPanel>
 </StackPanel>
</UserControl>
