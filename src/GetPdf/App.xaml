<Application x:Class="GetPdf.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:GetPdf.Controls">
  <Application.Resources>
    <!--
      GET Design System 4.1 foundations (07_BRAND_DOCUMENTATION/Master-Specification §3).
      Grid step 4 px; buttons 36/44 px, radius 10; fields 44 px; card 12; dialog 16.
      Interface font stays Segoe UI: DS 4.1 leaves the brand typeface open (D41-12).
    -->
    <SolidColorBrush x:Key="Navy" Color="#24305E"/>
    <SolidColorBrush x:Key="NavyDeep" Color="#18213F"/>
    <SolidColorBrush x:Key="NavyPressed" Color="#151B33"/>
    <SolidColorBrush x:Key="TealAccent" Color="#009CBC"/>
    <!-- #009CBC is below 4.5:1 on white; text, focus and selection use the darker teal. -->
    <SolidColorBrush x:Key="Teal" Color="#00809A"/>
    <SolidColorBrush x:Key="Red" Color="#E4032E"/>
    <SolidColorBrush x:Key="Yellow" Color="#FBBA00"/>
    <SolidColorBrush x:Key="Lime" Color="#AFCB37"/>
    <SolidColorBrush x:Key="Mint" Color="#8ACBC1"/>
    <SolidColorBrush x:Key="Ink" Color="#1B2240"/>
    <SolidColorBrush x:Key="Muted" Color="#5C6480"/>
    <SolidColorBrush x:Key="Faint" Color="#8A91A8"/>
    <SolidColorBrush x:Key="Border" Color="#E3E6EE"/>
    <SolidColorBrush x:Key="StrongBorder" Color="#CBD0DD"/>
    <SolidColorBrush x:Key="Surface" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Subtle" Color="#F1F4F9"/>
    <SolidColorBrush x:Key="CanvasBrush" Color="#F5F7FB"/>
    <SolidColorBrush x:Key="Raised" Color="#FAFBFD"/>
    <SolidColorBrush x:Key="AccentSoft" Color="#E6F5F9"/>

    <!-- Official GET mark (brandbook p.11, DS QA-verified asset); never redrawn or recoloured. -->
    <BitmapImage x:Key="GetMark" UriSource="pack://application:,,,/GetPdf;component/Assets/get-mark.png"/>
    <!-- Muted repeated underlay built from the same mark, only behind the document (GET PDF final layout). -->
    <ImageBrush x:Key="WorkspaceUnderlay" ImageSource="{StaticResource GetMark}" Opacity="0.06"
                TileMode="Tile" Stretch="Uniform" Viewport="0,0,520,400" ViewportUnits="Absolute"
                Viewbox="-0.45,-0.45,1.9,1.9" ViewboxUnits="RelativeToBoundingBox"/>

    <!-- GET DS functional icons, viewBox 24×24, outline stroke 1.75 (05_ICONS/SVG). -->
    <Geometry x:Key="IconSearch">M4.1,10.8 a6.7,6.7 0 1 0 13.4,0 a6.7,6.7 0 1 0 -13.4,0 M16,16 l5,5</Geometry>
    <Geometry x:Key="IconChevronLeft">M15,5 L8,12 L15,19</Geometry>
    <Geometry x:Key="IconChevronRight">M9,5 L16,12 L9,19</Geometry>
    <Geometry x:Key="IconChevronUp">M6,15 L12,9 L18,15</Geometry>
    <Geometry x:Key="IconChevronDown">M6,9 L12,15 L18,9</Geometry>
    <Geometry x:Key="IconPlus">M12,5 V19 M5,12 H19</Geometry>
    <Geometry x:Key="IconMinus">M5,12 H19</Geometry>
    <Geometry x:Key="IconX">M6,6 L18,18 M18,6 L6,18</Geometry>
    <Geometry x:Key="IconCheck">M5,12 L9.5,16.5 L19,7</Geometry>
    <Geometry x:Key="IconBox">M6,4 H18 A2,2 0 0 1 20,6 V18 A2,2 0 0 1 18,20 H6 A2,2 0 0 1 4,18 V6 A2,2 0 0 1 6,4 Z</Geometry>
    <Geometry x:Key="IconPrinter">M6,9 V3 H18 V9 M6,18 H4 A2,2 0 0 1 2,16 V11 A2,2 0 0 1 4,9 H20 A2,2 0 0 1 22,11 V16 A2,2 0 0 1 20,18 H18 M6,15 H18 V21 H6 Z M18,12 H18.01</Geometry>
    <Geometry x:Key="IconFileText">M13,3 H6 A2,2 0 0 0 4,5 V19 A2,2 0 0 0 6,21 H18 A2,2 0 0 0 20,19 V10 Z M13,3 V10 H20 M8,14 H16 M8,17 H14</Geometry>
    <Geometry x:Key="IconFolder">M3,7 A2,2 0 0 1 5,5 H10 L12,7 H19 A2,2 0 0 1 21,9 V19 A2,2 0 0 1 19,21 H5 A2,2 0 0 1 3,19 Z</Geometry>
    <Geometry x:Key="IconClock">M3,12 a9,9 0 1 0 18,0 a9,9 0 1 0 -18,0 M12,7 V12 L15,14</Geometry>
    <Geometry x:Key="IconStar">M12,2.8 L14.8,8.5 L21.1,9.4 L16.5,13.8 L17.6,20.1 L12,17.1 L6.4,20.1 L7.5,13.8 L2.9,9.4 L9.2,8.5 Z</Geometry>
    <Geometry x:Key="IconArrowUpRight">M7,17 L17,7 M8,7 H17 V16</Geometry>
    <Geometry x:Key="IconArrowLeft">M20,12 H4 M10,6 L4,12 L10,18</Geometry>
    <Geometry x:Key="IconArrowRight">M4,12 H20 M14,6 L20,12 L14,18</Geometry>
    <!-- Status icons for dialogs: alert-circle and its info/error variants (same circle, same stroke). -->
    <Geometry x:Key="IconAlert">M3,12 a9,9 0 1 0 18,0 a9,9 0 1 0 -18,0 M12,7 V13 M12,17 H12.01</Geometry>
    <Geometry x:Key="IconInfo">M3,12 a9,9 0 1 0 18,0 a9,9 0 1 0 -18,0 M12,11 V17 M12,7 H12.01</Geometry>
    <Geometry x:Key="IconError">M3,12 a9,9 0 1 0 18,0 a9,9 0 1 0 -18,0 M9,9 L15,15 M15,9 L9,15</Geometry>
    <Geometry x:Key="IconHelp">M3,12 a9,9 0 1 0 18,0 a9,9 0 1 0 -18,0 M9.5,9 A2.8,2.8 0 1 1 13.9,11.3 C13,12 12,12.5 12,14 M12,17 H12.01</Geometry>
    <Geometry x:Key="IconColumns">M5,4 H19 A2,2 0 0 1 21,6 V18 A2,2 0 0 1 19,20 H5 A2,2 0 0 1 3,18 V6 A2,2 0 0 1 5,4 Z M10,4 V20</Geometry>
    <Geometry x:Key="IconMonitor">M5,4 H19 A2,2 0 0 1 21,6 V15 A2,2 0 0 1 19,17 H5 A2,2 0 0 1 3,15 V6 A2,2 0 0 1 5,4 Z M8,21 H16 M12,17 V21</Geometry>
    <Geometry x:Key="IconPin">M19,10 C19,15 12,21 12,21 C12,21 5,15 5,10 A7,7 0 1 1 19,10 Z M9.5,10 a2.5,2.5 0 1 0 5,0 a2.5,2.5 0 1 0 -5,0</Geometry>
    <Geometry x:Key="IconBookOpen">M12,6 A8,8 0 0 0 3,4 V20 A8,8 0 0 1 12,22 A8,8 0 0 1 21,20 V4 A8,8 0 0 0 12,6 Z M12,6 V22</Geometry>
    <Geometry x:Key="IconRoute">M4,5 a2,2 0 1 0 4,0 a2,2 0 1 0 -4,0 M16,19 a2,2 0 1 0 4,0 a2,2 0 1 0 -4,0 M8,5 H14 A4,4 0 0 1 14,13 H10 A3,3 0 0 0 10,19 H16</Geometry>
    <Geometry x:Key="IconSliders">M4,7 H20 M4,17 H20 M7,7 a2,2 0 1 0 4,0 a2,2 0 1 0 -4,0 M14,17 a2,2 0 1 0 4,0 a2,2 0 1 0 -4,0</Geometry>
    <Geometry x:Key="IconFiles">M9,5 H18 A2,2 0 0 1 20,7 V19 A2,2 0 0 1 18,21 H9 A2,2 0 0 1 7,19 V7 A2,2 0 0 1 9,5 Z M16,5 V4 A2,2 0 0 0 14,2 H6 A2,2 0 0 0 4,4 V16 M11,10 H16 M11,14 H16</Geometry>
    <Geometry x:Key="IconShieldCheck">M12,2 L20,5 V11 C20,16 16.5,19 12,22 C7.5,19 4,16 4,11 V5 Z M8.5,12 L11,14.5 L15.5,9.5</Geometry>
    <Geometry x:Key="IconRotate">M21,8 A9,9 0 1 0 22,15 M21,3 V9 H15</Geometry>
    <Geometry x:Key="IconSend">M22,2 L15,22 L11,13 L2,9 Z M22,2 L11,13</Geometry>

    <!-- Keyboard-only focus ring: WPF shows FocusVisualStyle for keyboard navigation, not mouse clicks. -->
    <Style x:Key="GetFocusVisual">
      <Setter Property="Control.Template">
        <Setter.Value>
          <ControlTemplate>
            <Border Margin="-3" CornerRadius="12" BorderBrush="{StaticResource Teal}" BorderThickness="2" SnapsToDevicePixels="True"/>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Typography -->
    <!--
      No Foreground/FontSize here: an application-level implicit TextBlock style also hits the
      TextBlocks that ContentPresenter generates inside buttons, which would override role colours.
      The shell window sets Ink / Segoe UI / 13 as inherited defaults instead.
    -->
    <Style TargetType="TextBlock">
      <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>
    <Style x:Key="Heading" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
      <Setter Property="FontSize" Value="22"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{StaticResource Navy}"/>
    </Style>
    <Style x:Key="SectionHeading" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
      <Setter Property="FontSize" Value="15"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{StaticResource Navy}"/>
    </Style>
    <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
      <Setter Property="Foreground" Value="{StaticResource Muted}"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Margin" Value="0,0,0,4"/>
    </Style>
    <Style x:Key="CardBorder" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource Surface}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="12"/>
    </Style>
    <Style x:Key="ToolbarDivider" TargetType="Border">
      <Setter Property="Width" Value="1"/>
      <Setter Property="Height" Value="28"/>
      <Setter Property="Margin" Value="12,0"/>
      <Setter Property="Background" Value="{StaticResource Border}"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!--
      Buttons. One template for every DS role: optional icon (ui:Ui.Icon) + caption.
      Hover/pressed darken through an overlay so each role keeps its own colours.
    -->
    <Style TargetType="Button">
      <Setter Property="FontFamily" Value="Segoe UI"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{StaticResource Navy}"/>
      <Setter Property="Background" Value="{StaticResource Surface}"/>
      <Setter Property="BorderBrush" Value="{StaticResource StrongBorder}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="14,0"/>
      <Setter Property="MinHeight" Value="36"/>
      <Setter Property="MinWidth" Value="36"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="SnapsToDevicePixels" Value="True"/>
      <Setter Property="FocusVisualStyle" Value="{StaticResource GetFocusVisual}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid x:Name="Root">
              <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10"/>
              <Border x:Name="Overlay" Background="#0B1530" Opacity="0" CornerRadius="10"/>
              <!-- DockPanel (not StackPanel) so a long caption is width-constrained and trims with an ellipsis. -->
              <DockPanel Margin="{TemplateBinding Padding}" LastChildFill="True"
                         HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                         VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                <Viewbox x:Name="IconBox" DockPanel.Dock="Left" Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center">
                  <Canvas Width="24" Height="24">
                    <Path Data="{TemplateBinding ui:Ui.Icon}"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}"
                          StrokeThickness="1.75" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                  </Canvas>
                </Viewbox>
                <ContentPresenter x:Name="Caption" VerticalAlignment="Center" RecognizesAccessKey="True"/>
              </DockPanel>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="ui:Ui.Icon" Value="{x:Null}">
                <Setter TargetName="IconBox" Property="Visibility" Value="Collapsed"/>
              </Trigger>
              <Trigger Property="Content" Value="{x:Null}">
                <Setter TargetName="IconBox" Property="Margin" Value="0"/>
                <Setter TargetName="Caption" Property="Visibility" Value="Collapsed"/>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Overlay" Property="Opacity" Value="0.05"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Overlay" Property="Opacity" Value="0.11"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Root" Property="Opacity" Value="0.45"/>
                <Setter Property="Cursor" Value="Arrow"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <!-- Toggle commands (text selection, editor) show the DS selected state. -->
        <Trigger Property="ui:Ui.IsActive" Value="True">
          <Setter Property="Background" Value="{StaticResource AccentSoft}"/>
          <Setter Property="BorderBrush" Value="{StaticResource Teal}"/>
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"/>
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="{StaticResource Navy}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Navy}"/>
      <Setter Property="Foreground" Value="White"/>
    </Style>
    <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="{StaticResource Teal}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Teal}"/>
      <Setter Property="Foreground" Value="White"/>
    </Style>
    <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="{StaticResource Red}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Red}"/>
      <Setter Property="Foreground" Value="White"/>
    </Style>
    <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="Padding" Value="10,0"/>
    </Style>
    <!-- Icon-only command: needs AutomationProperties.Name and ToolTip (DS iconography rules). -->
    <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
      <Setter Property="Width" Value="44"/>
      <Setter Property="Height" Value="44"/>
      <Setter Property="Padding" Value="0"/>
    </Style>
    <Style x:Key="SmallIconButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
      <Setter Property="Width" Value="28"/>
      <Setter Property="Height" Value="28"/>
      <Setter Property="MinHeight" Value="28"/>
      <Setter Property="MinWidth" Value="28"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Foreground" Value="{StaticResource Muted}"/>
    </Style>
    <Style x:Key="SidebarButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
    </Style>

    <!-- Fields: 44 px, radius 10, teal focus border; optional leading icon and placeholder. -->
    <Style TargetType="TextBox">
      <Setter Property="FontFamily" Value="Segoe UI"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Foreground" Value="{StaticResource Ink}"/>
      <Setter Property="MinHeight" Value="36"/>
      <Setter Property="Padding" Value="10,0"/>
      <Setter Property="Background" Value="{StaticResource Surface}"/>
      <Setter Property="BorderBrush" Value="{StaticResource StrongBorder}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="SelectionBrush" Value="{StaticResource TealAccent}"/>
      <Setter Property="CaretBrush" Value="{StaticResource Navy}"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" SnapsToDevicePixels="True">
              <Grid>
                <Viewbox x:Name="IconBox" Width="18" Height="18" Margin="14,0,0,0"
                         HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False">
                  <Canvas Width="24" Height="24">
                    <Path Data="{TemplateBinding ui:Ui.Icon}"
                          Stroke="{StaticResource Muted}" StrokeThickness="1.75"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                  </Canvas>
                </Viewbox>
                <TextBlock x:Name="Hint" Text="{TemplateBinding ui:Ui.Placeholder}" Foreground="{StaticResource Muted}" FontWeight="Normal"
                           Margin="{TemplateBinding Padding}" Padding="2,0" VerticalAlignment="Center"
                           IsHitTestVisible="False" Visibility="Collapsed"/>
                <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" Focusable="False"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                              HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="ui:Ui.Icon" Value="{x:Null}">
                <Setter TargetName="IconBox" Property="Visibility" Value="Collapsed"/>
              </Trigger>
              <MultiTrigger>
                <MultiTrigger.Conditions>
                  <Condition Property="Text" Value=""/>
                  <Condition Property="IsKeyboardFocused" Value="False"/>
                </MultiTrigger.Conditions>
                <Setter TargetName="Hint" Property="Visibility" Value="Visible"/>
              </MultiTrigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource Faint}"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource Teal}"/>
                <Setter TargetName="Frame" Property="Background" Value="{StaticResource Surface}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Frame" Property="Opacity" Value="0.55"/>
              </Trigger>
              <Trigger Property="AcceptsReturn" Value="True">
                <Setter Property="VerticalContentAlignment" Value="Top"/>
                <Setter Property="Padding" Value="10,8"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="SearchField" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
      <Setter Property="Height" Value="44"/>
      <Setter Property="Padding" Value="42,0,12,0"/>
      <Setter Property="Background" Value="{StaticResource Subtle}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Subtle}"/>
      <Setter Property="ui:Ui.Icon" Value="{StaticResource IconSearch}"/>
    </Style>

    <Style TargetType="ComboBoxItem">
      <Setter Property="FontFamily" Value="Segoe UI"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Foreground" Value="{StaticResource Ink}"/>
      <Setter Property="Padding" Value="10,8"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBoxItem">
            <Border x:Name="Bd" Background="Transparent" CornerRadius="8" Padding="{TemplateBinding Padding}">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Subtle}"/>
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentSoft}"/>
                <Setter Property="Foreground" Value="{StaticResource Navy}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="FontFamily" Value="Segoe UI"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{StaticResource Navy}"/>
      <Setter Property="Background" Value="{StaticResource Surface}"/>
      <Setter Property="BorderBrush" Value="{StaticResource StrongBorder}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="MinHeight" Value="36"/>
      <Setter Property="Padding" Value="12,0,36,0"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{StaticResource GetFocusVisual}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBox">
            <Grid x:Name="Root">
              <ToggleButton Focusable="False" ClickMode="Press"
                            IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                <ToggleButton.Template>
                  <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Frame" CornerRadius="10" SnapsToDevicePixels="True"
                            Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                            BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                            BorderThickness="{Binding BorderThickness, RelativeSource={RelativeSource AncestorType=ComboBox}}">
                      <Viewbox Width="16" Height="16" HorizontalAlignment="Right" Margin="0,0,12,0">
                        <Canvas Width="24" Height="24">
                          <Path Data="{StaticResource IconChevronDown}" StrokeThickness="1.75"
                                Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                        </Canvas>
                      </Viewbox>
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="Frame" Property="Background" Value="{StaticResource Subtle}"/>
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </ToggleButton.Template>
              </ToggleButton>
              <ContentPresenter Margin="{TemplateBinding Padding}" IsHitTestVisible="False"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}" HorizontalAlignment="Left"
                                Content="{TemplateBinding SelectionBoxItem}"
                                ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
              <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                     AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}" BorderThickness="1"
                        CornerRadius="10" Margin="0,4,0,0" Padding="4" SnapsToDevicePixels="True"
                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                        MaxHeight="{TemplateBinding MaxDropDownHeight}">
                  <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                  </ScrollViewer>
                </Border>
              </Popup>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource Teal}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Root" Property="Opacity" Value="0.45"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="CheckBox">
      <Setter Property="FontFamily" Value="Segoe UI"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Foreground" Value="{StaticResource Ink}"/>
      <Setter Property="Margin" Value="0,6,0,6"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{StaticResource GetFocusVisual}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <StackPanel x:Name="Root" Orientation="Horizontal" Background="Transparent">
              <Border x:Name="Box" Width="20" Height="20" CornerRadius="6" BorderThickness="1.5"
                      BorderBrush="{StaticResource StrongBorder}" Background="{StaticResource Surface}" VerticalAlignment="Center">
                <Viewbox x:Name="Mark" Width="14" Height="14" Visibility="Collapsed">
                  <Canvas Width="24" Height="24">
                    <Path Data="{StaticResource IconCheck}" Stroke="White" StrokeThickness="3"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                  </Canvas>
                </Viewbox>
              </Border>
              <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True"/>
            </StackPanel>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Teal}"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Box" Property="Background" Value="{StaticResource Teal}"/>
                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Teal}"/>
                <Setter TargetName="Mark" Property="Visibility" Value="Visible"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Root" Property="Opacity" Value="0.45"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="ListBox">
      <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
      <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style TargetType="ListBoxItem">
      <Setter Property="Padding" Value="4"/>
      <Setter Property="Margin" Value="0,1"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="Bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="1.5"
                    CornerRadius="10" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Subtle}"/>
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentSoft}"/>
                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource TealAccent}"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Teal}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="ToolTip">
      <Setter Property="Background" Value="{StaticResource Navy}"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="FontFamily" Value="Segoe UI"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="MaxWidth" Value="360"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToolTip">
            <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="10,6">
              <ContentPresenter>
                <ContentPresenter.Resources>
                  <Style TargetType="TextBlock">
                    <Setter Property="TextWrapping" Value="Wrap"/>
                    <Setter Property="Foreground" Value="White"/>
                  </Style>
                </ContentPresenter.Resources>
              </ContentPresenter>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Dropdown menus (Вид страницы, Закладки, Переходы, Недавние, Комментарии PDF): DS card + 36 px rows. -->
    <Style TargetType="ContextMenu">
      <Setter Property="FontFamily" Value="Segoe UI"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Foreground" Value="{StaticResource Ink}"/>
      <Setter Property="HasDropShadow" Value="True"/>
      <Setter Property="MinWidth" Value="220"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ContextMenu">
            <!-- Margin leaves room for the soft shadow inside the transparent popup. -->
            <Border Margin="6,4,6,8" Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}"
                    BorderThickness="1" CornerRadius="10" Padding="4" SnapsToDevicePixels="True">
              <Border.Effect>
                <DropShadowEffect Color="#24305E" BlurRadius="16" ShadowDepth="3" Direction="270" Opacity="0.16"/>
              </Border.Effect>
              <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"/>
              </ScrollViewer>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="MenuItem">
      <Setter Property="FontFamily" Value="Segoe UI"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Foreground" Value="{StaticResource Ink}"/>
      <Setter Property="MinHeight" Value="36"/>
      <Setter Property="Padding" Value="10,0,14,0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="MenuItem">
            <Border x:Name="Row" Background="Transparent" CornerRadius="8" Padding="{TemplateBinding Padding}"
                    MinHeight="{TemplateBinding MinHeight}" SnapsToDevicePixels="True">
              <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="24"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Viewbox x:Name="Check" Width="16" Height="16" Visibility="Hidden" HorizontalAlignment="Left">
                  <Canvas Width="24" Height="24">
                    <Path Data="{StaticResource IconCheck}" Stroke="{StaticResource Teal}" StrokeThickness="2.25"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                  </Canvas>
                </Viewbox>
                <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center"/>
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{StaticResource Navy}"/>
              </Trigger>
              <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="Row" Property="Background" Value="{StaticResource Subtle}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{StaticResource Faint}"/>
                <Setter Property="Cursor" Value="Arrow"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="Separator">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Separator">
            <Border Height="1" Margin="8,4" Background="{StaticResource Border}"/>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Thin scrollbars: neutral thumb on a transparent track, no arrow buttons. -->
    <Style x:Key="ScrollThumb" TargetType="Thumb">
      <Setter Property="Background" Value="{StaticResource StrongBorder}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Thumb">
            <Border Background="{TemplateBinding Background}" CornerRadius="4"/>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{StaticResource Faint}"/></Trigger>
        <Trigger Property="IsDragging" Value="True"><Setter Property="Background" Value="{StaticResource Muted}"/></Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="ScrollPage" TargetType="RepeatButton">
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="IsTabStop" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ScrollBar">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Width" Value="10"/>
      <Setter Property="MinWidth" Value="10"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Grid Background="{TemplateBinding Background}">
              <Track x:Name="PART_Track" IsDirectionReversed="True">
                <Track.DecreaseRepeatButton><RepeatButton Style="{StaticResource ScrollPage}" Command="ScrollBar.PageUpCommand"/></Track.DecreaseRepeatButton>
                <Track.Thumb><Thumb Style="{StaticResource ScrollThumb}" Margin="2"/></Track.Thumb>
                <Track.IncreaseRepeatButton><RepeatButton Style="{StaticResource ScrollPage}" Command="ScrollBar.PageDownCommand"/></Track.IncreaseRepeatButton>
              </Track>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="Orientation" Value="Horizontal">
          <Setter Property="Width" Value="Auto"/>
          <Setter Property="MinWidth" Value="0"/>
          <Setter Property="Height" Value="10"/>
          <Setter Property="MinHeight" Value="10"/>
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="ScrollBar">
                <Grid Background="{TemplateBinding Background}">
                  <Track x:Name="PART_Track" IsDirectionReversed="False">
                    <Track.DecreaseRepeatButton><RepeatButton Style="{StaticResource ScrollPage}" Command="ScrollBar.PageLeftCommand"/></Track.DecreaseRepeatButton>
                    <Track.Thumb><Thumb Style="{StaticResource ScrollThumb}" Margin="2"/></Track.Thumb>
                    <Track.IncreaseRepeatButton><RepeatButton Style="{StaticResource ScrollPage}" Command="ScrollBar.PageRightCommand"/></Track.IncreaseRepeatButton>
                  </Track>
                </Grid>
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style TargetType="ProgressBar">
      <Setter Property="Foreground" Value="{StaticResource TealAccent}"/>
      <Setter Property="Background" Value="{StaticResource Subtle}"/>
      <Setter Property="BorderThickness" Value="0"/>
    </Style>

    <!-- Editor groups inside the inspector: segmented control, wraps in the 230–280 px pane. -->
    <Style x:Key="DocumentToolTab" TargetType="TabItem">
      <Setter Property="Foreground" Value="{StaticResource Muted}"/>
      <Setter Property="FontFamily" Value="Segoe UI"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Padding" Value="12,0"/>
      <Setter Property="MinHeight" Value="36"/>
      <Setter Property="Margin" Value="0,0,4,4"/>
      <Setter Property="FocusVisualStyle" Value="{StaticResource GetFocusVisual}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem">
        <Border x:Name="TabRoot" Background="Transparent" CornerRadius="10" Padding="{TemplateBinding Padding}">
          <ContentPresenter ContentSource="Header" VerticalAlignment="Center"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="TabRoot" Property="Background" Value="{StaticResource Subtle}"/></Trigger>
          <Trigger Property="IsSelected" Value="True">
            <Setter Property="Foreground" Value="{StaticResource Navy}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter TargetName="TabRoot" Property="Background" Value="{StaticResource AccentSoft}"/>
          </Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="DocumentToolTabs" TargetType="TabControl">
      <Setter Property="BorderThickness" Value="0"/><Setter Property="Background" Value="Transparent"/>
      <Setter Property="ItemContainerStyle" Value="{StaticResource DocumentToolTab}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabControl"><!-- WrapPanel keeps the group order; TabPanel would move the selected row. --><WrapPanel IsItemsHost="True" HorizontalAlignment="Left"/></ControlTemplate></Setter.Value></Setter>
    </Style>

    <!-- Window shell: GET mark + product name, document tabs and "+" in one header row. -->
    <Style x:Key="ShellTab" TargetType="TabItem">
      <Setter Property="Foreground" Value="{StaticResource Muted}"/>
      <Setter Property="FontFamily" Value="Segoe UI"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Height" Value="44"/>
      <Setter Property="Padding" Value="12,0,6,0"/>
      <Setter Property="Margin" Value="0,0,4,0"/>
      <Setter Property="VerticalAlignment" Value="Bottom"/>
      <Setter Property="FocusVisualStyle" Value="{StaticResource GetFocusVisual}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem">
        <Grid>
          <Border x:Name="TabRoot" Background="{StaticResource CanvasBrush}" CornerRadius="10,10,0,0" Padding="{TemplateBinding Padding}">
            <ContentPresenter ContentSource="Header" VerticalAlignment="Center"/>
          </Border>
          <Border x:Name="Underline" Height="2" VerticalAlignment="Bottom" Margin="10,0" Background="{StaticResource TealAccent}"
                  CornerRadius="1" Visibility="Hidden"/>
        </Grid>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="TabRoot" Property="Background" Value="{StaticResource Subtle}"/></Trigger>
          <Trigger Property="IsSelected" Value="True">
            <Setter Property="Foreground" Value="{StaticResource Navy}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter TargetName="TabRoot" Property="Background" Value="{StaticResource Subtle}"/>
            <Setter TargetName="Underline" Property="Visibility" Value="Visible"/>
          </Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="ShellTabs" TargetType="TabControl">
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Background" Value="{StaticResource Surface}"/>
      <Setter Property="ItemContainerStyle" Value="{StaticResource ShellTab}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabControl">
        <DockPanel>
          <Border DockPanel.Dock="Top" Height="64" Background="{StaticResource Surface}"
                  BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" Padding="20,0,12,0">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <ui:GetBrand VerticalAlignment="Center" Margin="0,0,32,0"/>
              <Grid x:Name="PART_Strip" Grid.Column="1" ClipToBounds="True">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <ui:TabStripPanel x:Name="PART_TabStrip" IsItemsHost="True" VerticalAlignment="Bottom"
                                  KeyboardNavigation.TabIndex="1"/>
                <ContentPresenter Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="4,0,0,0"
                                  Content="{Binding Tag.Leading, RelativeSource={RelativeSource TemplatedParent}}"/>
              </Grid>
              <ContentPresenter Grid.Column="2" VerticalAlignment="Center" Margin="12,0,0,0"
                                Content="{Binding Tag.Trailing, RelativeSource={RelativeSource TemplatedParent}}"/>
            </Grid>
          </Border>
          <!-- Name required: TabItemAutomationPeer exposes tab content to UI Automation / screen readers through it. -->
          <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent"/>
        </DockPanel>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
  </Application.Resources>
</Application>
