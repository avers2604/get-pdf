<Window x:Class="GetPdf.Setup.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="800" Height="520" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" WindowStyle="None" Background="{StaticResource Surface}"
        FontFamily="Segoe UI" Foreground="{StaticResource Ink}" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display" Loaded="Window_Loaded" Closing="Window_Closing">
  <!-- Own GET DS chrome; Windows still draws the shadow and rounded corners (WindowChrome). -->
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="44" ResizeBorderThickness="0" GlassFrameThickness="1" CornerRadius="0"
                  UseAeroCaptionButtons="False"/>
  </WindowChrome.WindowChrome>
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="264"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <!-- Brand rail: inverse official mark on corporate navy, and where the wizard is. -->
    <Grid Background="{StaticResource Navy}">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <StackPanel Margin="32,40,24,0">
        <Image Source="pack://application:,,,/Assets/get-mark-inverse.png" Width="64" Height="64"
               HorizontalAlignment="Left" RenderOptions.BitmapScalingMode="HighQuality"/>
        <TextBlock x:Name="ProductText" Foreground="White" FontSize="24" FontWeight="SemiBold" Margin="0,20,0,0"/>
        <TextBlock x:Name="VersionText" Text="Версия" Foreground="#B9C0D6" FontSize="13" Margin="0,4,0,0"/>
      </StackPanel>
      <StackPanel Grid.Row="1" Margin="32,44,24,0" VerticalAlignment="Top">
        <TextBlock x:Name="Step1" Text="1   Параметры" Foreground="White" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,16"/>
        <TextBlock x:Name="Step2" Text="2   Установка" Foreground="White" Opacity="0.55" FontSize="14" Margin="0,0,0,16"/>
        <TextBlock x:Name="Step3" Text="3   Готово" Foreground="White" Opacity="0.55" FontSize="14"/>
      </StackPanel>
      <TextBlock Grid.Row="2" Text="СПб ГУП «Горэлектротранс»" Foreground="#8F98B5" FontSize="12" Margin="32,0,24,28"/>
    </Grid>

    <Grid Grid.Column="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="44"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <Button x:Name="CloseButton" Style="{StaticResource GhostButton}" Width="44" Height="44" Padding="0"
              HorizontalAlignment="Right" VerticalAlignment="Top" WindowChrome.IsHitTestVisibleInChrome="True"
              Click="Close_Click" ToolTip="Закрыть" AutomationProperties.Name="Закрыть">
        <Viewbox Width="16" Height="16"><Canvas Width="24" Height="24">
          <Path Data="{StaticResource IconX}" Stroke="{StaticResource Muted}" StrokeThickness="2"
                StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
        </Canvas></Viewbox>
      </Button>

      <!-- 1. Parameters -->
      <StackPanel x:Name="WelcomePanel" Grid.Row="1" Margin="44,4,44,0">
        <TextBlock x:Name="WelcomeTitle" Style="{StaticResource Heading}"/>
        <TextBlock x:Name="WelcomeText" Style="{StaticResource Body}" Margin="0,10,0,0"/>
        <!-- DS inline warning (yellow): e.g. the program is still open during an update. -->
        <Border x:Name="AlertBox" Visibility="Collapsed" Background="#FFF6DD" BorderBrush="#FBBA00" BorderThickness="1"
                CornerRadius="10" Padding="14,10" Margin="0,16,0,0">
          <DockPanel>
            <Viewbox Width="18" Height="18" Margin="0,0,10,0" VerticalAlignment="Top" DockPanel.Dock="Left">
              <Canvas Width="24" Height="24"><Path Data="{StaticResource IconAlert}" Stroke="#8A6200" StrokeThickness="1.75"
                StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/></Canvas>
            </Viewbox>
            <TextBlock x:Name="AlertText" FontSize="13" Foreground="{StaticResource Ink}"/>
          </DockPanel>
        </Border>
        <StackPanel x:Name="FeatureList" Margin="0,18,0,0">
          <StackPanel.Resources>
            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
              <Setter Property="FontSize" Value="13"/>
              <Setter Property="Foreground" Value="{StaticResource Ink}"/>
              <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
          </StackPanel.Resources>
          <!-- Filled from Product.Features (one check row per feature). -->
        </StackPanel>
        <StackPanel x:Name="FolderSection" Margin="0,22,0,0">
          <TextBlock Text="Папка установки" Style="{StaticResource FieldLabel}"/>
          <DockPanel>
            <Button DockPanel.Dock="Right" Content="Изменить…" Margin="8,0,0,0" Click="ChangeFolder_Click"
                    AutomationProperties.Name="Изменить папку установки"/>
            <TextBox x:Name="FolderBox" IsReadOnly="True" AutomationProperties.Name="Папка установки"/>
          </DockPanel>
        </StackPanel>
        <CheckBox x:Name="DefaultAppCheck" IsChecked="True" Margin="0,18,0,0">
          <StackPanel>
            <TextBlock x:Name="DefaultAppText" FontSize="13" Foreground="{StaticResource Ink}"/>
            <TextBlock x:Name="DefaultAppHint" TextWrapping="Wrap"
                       FontSize="12" Foreground="{StaticResource Muted}" Margin="0,2,0,0"/>
          </StackPanel>
        </CheckBox>
      </StackPanel>

      <!-- 2. Progress -->
      <StackPanel x:Name="ProgressPanel" Grid.Row="1" Margin="44,4,44,0" Visibility="Collapsed">
        <TextBlock x:Name="ProgressTitle" Style="{StaticResource Heading}"/>
        <TextBlock Style="{StaticResource Body}" Margin="0,10,0,0"
                   Text="Это займёт около минуты. Не выключайте компьютер."/>
        <ProgressBar x:Name="InstallProgress" Margin="0,40,0,0" Minimum="0" Maximum="1" Value="0"
                     AutomationProperties.Name="Ход установки"/>
        <DockPanel Margin="0,12,0,0">
          <TextBlock x:Name="PercentText" DockPanel.Dock="Right" Text="0 %" FontSize="13" FontWeight="SemiBold"
                     Foreground="{StaticResource Navy}" TextWrapping="NoWrap"/>
          <TextBlock x:Name="ActionText" Text="Подготовка…" FontSize="13" Foreground="{StaticResource Muted}"
                     TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
        </DockPanel>
      </StackPanel>

      <!-- 3. Result -->
      <StackPanel x:Name="DonePanel" Grid.Row="1" Margin="44,4,44,0" Visibility="Collapsed">
        <Border x:Name="ResultBadge" Width="56" Height="56" CornerRadius="28" Background="{StaticResource SuccessSoft}"
                HorizontalAlignment="Left">
          <Viewbox Width="28" Height="28"><Canvas Width="24" Height="24">
            <Path x:Name="ResultIcon" Data="{StaticResource IconCheck}" Stroke="#5E7A10" StrokeThickness="2.5"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
          </Canvas></Viewbox>
        </Border>
        <TextBlock x:Name="DoneTitle" Style="{StaticResource Heading}" Margin="0,20,0,0"/>
        <TextBlock x:Name="DoneText" Style="{StaticResource Body}" Margin="0,10,0,0"
                   Text="Программа добавлена в меню «Пуск»."/>
        <CheckBox x:Name="LaunchCheck" IsChecked="True" Margin="0,24,0,0"/>
        <Button x:Name="LogButton" Content="Открыть журнал установки" Style="{StaticResource GhostButton}"
                HorizontalAlignment="Left" Margin="-12,16,0,0" Click="OpenLog_Click" Visibility="Collapsed"/>
      </StackPanel>

      <!-- Footer actions -->
      <Border Grid.Row="2" BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0" Padding="44,16">
        <DockPanel LastChildFill="False">
          <Button x:Name="RemoveButton" Style="{StaticResource DangerGhostButton}"
                  DockPanel.Dock="Left" Margin="-12,0,0,0" Click="Remove_Click" Visibility="Collapsed"/>
          <Button x:Name="PrimaryButton" Content="Установить" Style="{StaticResource PrimaryButton}" DockPanel.Dock="Right"
                  MinWidth="140" IsDefault="True" Click="Primary_Click"/>
          <Button x:Name="SecondaryButton" Content="Отмена" Style="{StaticResource GhostButton}" DockPanel.Dock="Right"
                  Margin="0,0,8,0" IsCancel="True" Click="Secondary_Click"/>
        </DockPanel>
      </Border>
    </Grid>
  </Grid>
</Window>
