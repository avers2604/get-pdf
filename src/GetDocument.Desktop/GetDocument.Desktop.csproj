<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>GetDocument.Desktop</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationIcon>Assets\get-document.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Product>ГЭТ Документ</Product>
    <Company>SPb GUP Gorelektrotrans</Company>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <PackageReference Include="Avalonia.Controls.WebView" Version="12.1.1" />
    <PackageReference Include="PDFtoImage" Version="5.4.0" />
    <!-- Reuse the exact PdfPig version already carried by the legacy GET PDF project. -->
    <PackageReference Include="PdfPig" Version="0.1.16" />
  </ItemGroup>
  <ItemGroup>
    <AvaloniaResource Include="Assets/get-mark.png" />
    <AvaloniaResource Include="Assets/get-document.ico" />
    <!-- File-type icons referenced by the installer's ProgIDs (DefaultIcon). -->
    <None Include="Assets/*-document.ico" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../GetDocument.Core/GetDocument.Core.csproj" />
    <ProjectReference Include="../GetDocument.Office/GetDocument.Office.csproj" />
    <ProjectReference Include="../GetDocument.Images/GetDocument.Images.csproj" />
    <ProjectReference Include="../GetDocument.Revisions/GetDocument.Revisions.csproj" />
    <ProjectReference Include="../GetDocument.Pdf/GetDocument.Pdf.csproj" />
  </ItemGroup>
</Project>
